# SMTP delivery configuration. Copy the values to the deployment environment;
# do not commit a real .env file or any credentials.
CARTECH_OFFICE_EMAIL=office@example.com
CARTECH_SMTP_HOST=smtp.example.com
CARTECH_SMTP_PORT=587
CARTECH_SMTP_USERNAME=cartech@example.com
CARTECH_SMTP_PASSWORD=replace-with-a-secret-from-your-provider
CARTECH_SMTP_FROM=cartech@example.com

# STARTTLS is the normal configuration for port 587. For implicit TLS (usually
# port 465), set CARTECH_SMTP_USE_SSL=true; STARTTLS is then not used.
CARTECH_SMTP_USE_TLS=true
CARTECH_SMTP_USE_SSL=false
CARTECH_SMTP_TIMEOUT_SECONDS=15
