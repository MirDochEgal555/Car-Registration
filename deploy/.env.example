# Public hostname pointing to this VPS. Caddy obtains and renews HTTPS
# certificates automatically; DNS must point this hostname to the server first.
CARTECH_DOMAIN=cartech.example.de

# Persist the delivery outbox outside the container filesystem.
CARTECH_DELIVERY_STORE_PATH=/var/lib/cartech/cartech-deliveries.sqlite3

# Email delivery. Use a dedicated test inbox during the workshop pilot.
CARTECH_OFFICE_EMAIL=office@example.com
CARTECH_SMTP_HOST=smtp.example.com
CARTECH_SMTP_PORT=587
CARTECH_SMTP_USERNAME=cartech@example.com
CARTECH_SMTP_PASSWORD=replace-with-a-secret
CARTECH_SMTP_FROM=cartech@example.com
CARTECH_SMTP_USE_TLS=true
CARTECH_SMTP_USE_SSL=false
CARTECH_SMTP_TIMEOUT_SECONDS=15

# OpenAI credentials stay only on the VPS. Never commit this filled file.
CARTECH_OPENAI_API_KEY=replace-with-an-openai-api-key
CARTECH_OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
CARTECH_OPENAI_EXTRACTION_MODEL=gpt-4o-mini
CARTECH_OPENAI_TIMEOUT_SECONDS=30

# The browser and API are served from the same HTTPS domain. This remains
# useful for direct API diagnostics and must be changed if a separate frontend
# domain is ever used.
CARTECH_CORS_ORIGINS=https://cartech.example.de

