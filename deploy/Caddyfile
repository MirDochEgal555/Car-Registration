{$CARTECH_DOMAIN} {
    # mTLS is the sole access control: every client must present a certificate
    # signed by the private CarTech client CA mounted at this path.
    tls {
        client_auth {
            mode require_and_verify
            trust_pool file /etc/caddy/client-ca.pem
        }
    }

    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
    }

    # `try_files` is normally ordered before `reverse_proxy` by Caddy's
    # directive sorter. Keep these handlers in this explicit order so API
    # paths cannot be rewritten to the SPA's index.html first.
    route {
        @api path /api/*
        reverse_proxy @api api:8000

        root * /srv
        try_files {path} /index.html
        file_server
    }
}
